# Copy this file to .env and fill it in. .env is never committed (it's in .gitignore).

# Your user folder name: lowercase letters, digits, hyphens. Created on first start.
RB_DEFAULT_USER=your-name

# Contact details for documents. Kept here, never in your data folder or the database.
RB_CONTACT_EMAIL=you@example.com
RB_CONTACT_PHONE=

# Your user and group ids, so files the app writes stay editable by you.
# Find them with `id -u` and `id -g` (macOS is usually 501 and 20; Linux usually 1000 and 1000).
PUID=1000
PGID=1000

# Your time zone, e.g. America/New_York
TZ=UTC

# Where things live on your machine (relative to this folder), and the local port.
RB_HOST_DATA=./data
RB_HOST_OUTPUT=./output
RB_HOST_BACKUPS=./backups
RB_HOST_PORT=8000

# Extra names the website answers to, comma-separated (only names that point to this computer).
# localhost and 127.0.0.1 always work; anything else is refused, so other websites can't read it.
# RB_WEB_HOSTS=
