<!doctype html>
{#- Released template: resume/classic v1. Never edit after release; add a new version folder instead (PRD R12.7). -#}
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ c.person.name }}{% if c.doc_type != 'public_site' %} — Resume{% endif %}</title>
<meta name="author" content="{{ c.person.name }}">
<meta name="generator" content="resume-builder {{ c.app_version }}">
<meta name="dcterms.created" content="{{ created }}">
<meta name="dcterms.modified" content="{{ created }}">
{% if c.doc_type == 'public_site' %}<meta name="viewport" content="width=device-width, initial-scale=1">{% endif %}
<style>{{ css | safe }}</style>
</head>
<body class="{{ c.variant }}{% if c.preview %} preview{% endif %}{% if c.doc_type == 'public_site' %} site{% endif %}">
{% if c.preview %}<div class="watermark">PREVIEW: contains draft content</div>{% endif %}
<header>
  <h1>{{ c.person.name }}</h1>
  {% if c.person.headline %}<p class="headline">{{ c.person.headline }}</p>{% endif %}
  <p class="contact">
    {%- set parts = [] -%}
    {%- if c.person.location %}{% set _ = parts.append(c.person.location) %}{% endif -%}
    {#- Contact details appear only in documents, never on the public site (PRD section 10). -#}
    {%- if c.doc_type != 'public_site' %}
      {%- if contact.email %}{% set _ = parts.append(contact.email) %}{% endif -%}
      {%- if contact.phone %}{% set _ = parts.append(contact.phone) %}{% endif -%}
    {%- endif -%}
    {{ parts | join(' · ') }}
    {%- for l in c.person.links %} · <a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
  </p>
</header>

{% if c.sections.summary %}
<section>
  <h2>Summary</h2>
  <p>{{ c.sections.summary | join(' ') }}</p>
</section>
{% endif %}

{% if c.sections.roles %}
<section>
  <h2>Experience</h2>
  {% for r in c.sections.roles %}
  <article class="item">
    <div class="item-head">
      <span class="title">{{ r.title }}</span>{% if r.official_title %} <span class="official">(official title: {{ r.official_title }})</span>{% endif %}
      <span class="dates">{{ r.start }} – {{ r.end }}</span>
    </div>
    <div class="org">{{ r.company }}{% if r.location %}, {{ r.location }}{% endif %}</div>
    <ul>{% for b in r.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
  </article>
  {% endfor %}
</section>
{% endif %}

{% if c.sections.projects %}
<section>
  <h2>Projects</h2>
  {% for p in c.sections.projects %}
  <article class="item">
    <div class="item-head"><span class="title">{{ p.name }}</span>{% if p.start %}<span class="dates">{{ p.start }} – {{ p.end or 'present' }}</span>{% endif %}</div>
    {% if p.description %}<p>{{ p.description }}</p>{% endif %}
    <ul>{% for b in p.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
  </article>
  {% endfor %}
</section>
{% endif %}

{% if c.sections.skills %}
<section>
  <h2>Skills</h2>
  <dl class="skills">{% for g in c.sections.skills %}<dt>{{ g.name }}</dt><dd>{{ g['items'] | join(', ') }}</dd>{% endfor %}</dl>
</section>
{% endif %}

{% if c.sections.education %}
<section>
  <h2>Education</h2>
  {% for e in c.sections.education %}
  <p>{% if e.degree %}{{ e.degree }}{% if e.field %}, {{ e.field }}{% endif %} — {% endif %}{{ e.institution }}{% if e.end %} ({{ e.end }}){% endif %}</p>
  {% endfor %}
</section>
{% endif %}

{% if c.sections.certifications %}
<section>
  <h2>Certifications</h2>
  {% for cert in c.sections.certifications %}<p>{{ cert.name }}{% if cert.issuer %}, {{ cert.issuer }}{% endif %}{% if cert.date %} ({{ cert.date }}){% endif %}</p>{% endfor %}
</section>
{% endif %}
</body>
</html>
